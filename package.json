{
  "name": "dsh-hybrid-workspace-v2",
  "version": "2.3.2",
  "description": "单聊天框 + 多工作区上下文路由 v2.3.2：每区策略、导出导入（含全局档案与来源链）、trace 解释、迁移逐条勾选、cost-meter 可选桥接、结论演变、连续问句拆段",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuoyuan333/dsh-hybrid-workspace-v2.git"
  },
  "homepage": "https://github.com/zuoyuan333/dsh-hybrid-workspace-v2#readme",
  "bugs": {
    "url": "https://github.com/zuoyuan333/dsh-hybrid-workspace-v2/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/all.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "scripts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
